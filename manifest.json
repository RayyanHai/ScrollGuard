{
  "manifest_version": 3,
  "name": "ScrollGuard",
  "version": "4.0.0",
  "minimum_chrome_version": "120",
  "description": "Track website time, close tabs at your daily limit, and earn short breaks with math. Resets at 6 AM.",
  "permissions": ["storage", "tabs", "alarms", "scripting", "idle", "notifications"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon-192.png",
    "32": "icons/icon-192.png",
    "48": "icons/icon-192.png",
    "128": "icons/icon-192.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ScrollGuard",
    "default_icon": {
      "16": "icons/icon-192.png",
      "32": "icons/icon-192.png",
      "48": "icons/icon-192.png",
      "128": "icons/icon-192.png"
    }
  },
  "options_page": "options/options.html"
}
