{
  "manifest_version": 3,
  "name": "ScrollGuard",
  "version": "0.1.0",
  "description": "Personal Instagram intervention tool. Tracks per-context usage and intervenes when limits are hit.",
  "permissions": ["storage", "webNavigation", "tabs"],
  "host_permissions": ["*://*.instagram.com/*"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["lib/classifier.js", "content/intervention.js", "content/detector.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-192.png",
    "32": "icons/icon-192.png",
    "48": "icons/icon-192.png",
    "128": "icons/icon-192.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ScrollGuard",
    "default_icon": {
      "16": "icons/icon-192.png",
      "32": "icons/icon-192.png",
      "48": "icons/icon-192.png",
      "128": "icons/icon-192.png"
    }
  },
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": ["dashboard/dashboard.html", "dashboard/dashboard.js"],
      "matches": ["*://*.instagram.com/*"]
    }
  ]
}
